# ==============================================================================
# DramaFlow 环境变量配置模板
# 复制此文件为 .env 并填入实际参数：cp env.template .env
# ==============================================================================

# 服务端口（默认 8000）
PORT=8000

# ------------------------------------------------------------------------------
# 1. API 访问安全鉴权 (Security)
# ------------------------------------------------------------------------------
# 客户端通过 Header 中的 X-Access-Secret 传入进行鉴权。若未设置则不校验。
DARMAFLOW_API_ACCESS_SECRET=your_api_access_secret_here

# ------------------------------------------------------------------------------
# 2. TTS 语音合成供应商配置 (TTS Providers)
# ------------------------------------------------------------------------------
# [Advance / 付费] ElevenLabs API Key (用于高质量角色对话与情感调节)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# [Basic / VIP 旁白] OpenAI API Key (用于 VIP 用户的旁白高质感合成)
OPENAI_API_KEY=your_openai_api_key_here

# [Basic / 免费旁白] Azure Cognitive Services Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# [Basic / 对话音色池] Google Cloud Text-to-Speech
# 方式一：直接提供 Service Account 的 JSON 字符串（常用于云部署环境）
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type": "service_account", ...}

# 方式二：指定本地 Service Account JSON 文件路径（本地开发可选）
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 / S3 兼容对象存储 (Storage)
# ------------------------------------------------------------------------------
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=dramaflow
# 公开访问域名 (不带末尾斜杠，如 r2.yourdomain.com 或 pub-xxx.r2.dev)
R2_PUBLIC_DOMAIN=https://pub-xxx.r2.dev
# 存储目录所属项目标识
R2_PROJECT_ID=DramaFlowProduction
